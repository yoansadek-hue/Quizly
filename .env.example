# Copiez ce fichier en .env (ne jamais le commiter). Sur Render : onglet Environment.
# IA qui écrit les questions (API compatible OpenAI ; par défaut Groq)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-120b
REASONING_EFFORT=low
# Notifications (clés VAPID) et mode développeur (annonces)
VAPID_PUBLIC=
VAPID_PRIVATE=
ADMIN_KEY=
PORT=3000
